# IW Generator - environment variables
# Copy to .env.local for local dev. Never commit .env.local.
# Production secrets live in the Replit Secrets panel (current) or Vercel env panel (post-migration).
# Rotate every 90 days or immediately on any team change.

# ---- Core ----
NODE_ENV=development
PORT=5000

# ---- Database (Neon Postgres via @neondatabase/serverless) ----
# Get from Neon dashboard or Replit Secrets. Format: postgres://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# ---- Session ----
# Random 32+ char hex. Generate with: openssl rand -hex 32
SESSION_SECRET=

# ---- Admin authorisation ----
# Comma-separated email list. The auth layer reads this array; never an equality check on a single email.
# Example: irfan@gardenproject.pro,tabassam@islamicwills.pro,riaz@gardenproject.pro
ADMIN_EMAILS=

# ---- Payments (Stripe) ----
# Live and test keys. Use test in non-production.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@islamicwills.pro

# ---- AI (Anthropic, conversational layer) ----
ANTHROPIC_API_KEY=

# ---- Observability ----
# Sentry: use an Organization Auth Token, not a User Auth Token. Scope: org:ci.
# DSN is client-side identifier (safe to be public-readable). Token is build-time only (Vercel/Replit env, not .env.local).
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Plausible (cookie-less analytics)
VITE_PLAUSIBLE_DOMAIN=islamicwills.pro
VITE_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# ---- Public site ----
PUBLIC_SITE_URL=https://islamicwills.pro